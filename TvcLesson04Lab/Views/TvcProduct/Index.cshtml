@{
    ViewData["Title"] = "Rito VLR Store";
    var tvcProducts = ViewBag.TvcProducts as List<TvcProduct> ?? new List<TvcProduct>();
    var tvcCategories = ViewBag.TvcCategories as List<TvcCategory> ?? new List<TvcCategory>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
}

<div class="container-fluid my-4">
    <div class="row">
        <!-- Sidebar Danh mục -->
        <div class="col-md-3 col-lg-2">
            <div class="category-sidebar p-3 border rounded shadow-sm bg-white">
                <h5 class="fw-bold mb-3 text-primary">DANH MỤC</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a asp-controller="TvcProduct" asp-action="Index"
                           class="text-decoration-none d-flex justify-content-between align-items-center @(!selectedCategory.HasValue ? "fw-bold text-primary" : "text-dark")">
                            <span>Tất cả</span>
                        </a>
                    </li>
                    @if (tvcCategories.Any())
                    {
                        @foreach (var category in tvcCategories)
                        {
                            <li class="mb-2">
                                <a asp-controller="TvcProduct" asp-action="Index"
                                   asp-route-categoryId="@category.Id"
                                   class="text-decoration-none d-flex justify-content-between align-items-center @(selectedCategory == category.Id ? "fw-bold text-primary" : "text-dark")">
                                    <span>
                                        @if (!string.IsNullOrEmpty(category.Icon))
                                        {
                                            <i class="fas @category.Icon me-1"></i>
                                        }
                                        @category.Name
                                    </span>
                                    <span class="badge bg-light text-dark border">@category.ProductCount</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-md-9 col-lg-10">
            <div class="row">
                @if (tvcProducts.Any())
                {
                    @foreach (TvcProduct item in tvcProducts)
                    {
                        <div class="col-md-6 col-lg-4 my-2 d-flex align-items-stretch">
                            <div class="card w-100 shadow-sm border-0">
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="img mb-2">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="w-100 rounded" style="height: 200px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="w-100 rounded" style="height: 200px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                                    <span class="text-muted">No Image</span>
                                                </div>
                                            }
                                        </div>

                                        <h5 class="card-title fw-bold">@item.Name</h5>
                                        <p class="text-muted small" style="-webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden;">
                                            @item.Description
                                        </p>

                                        <div class="mb-2">
                                            <span class="text-decoration-line-through text-muted small">@item.Price.ToString("N0") VNĐ</span><br />
                                            <span class="text-danger fw-bold fs-5">@item.SalePrice.ToString("N0") VNĐ</span>
                                        </div>

                                        <div class="mb-3">
                                            <span class="badge bg-secondary">@item.Category</span>
                                            <span class="badge bg-info text-dark">@item.ReleaseYear</span>
                                            @if (item.IsHot)
                                            {
                                                <span class="badge bg-warning text-dark">HOT</span>
                                            }
                                            @if (item.IsNew)
                                            {
                                                <span class="badge bg-success">NEW</span>
                                            }
                                        </div>
                                    </div>

                                    <a asp-controller="TvcProduct" asp-action="TvcSanPham" asp-route-id="@item.Id" class="btn btn-success w-100">
                                        Chi Tiết Sản Phẩm
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <h4>Không tìm thấy sản phẩm nào</h4>
                        <p class="text-muted">Chưa có sản phẩm thuộc danh mục này.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>