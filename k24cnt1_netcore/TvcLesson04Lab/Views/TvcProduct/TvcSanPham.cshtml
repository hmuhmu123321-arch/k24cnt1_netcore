@{
    var product = ViewBag.TvcProduct as TvcProduct;
    var relatedProducts = ViewBag.RelatedProducts as List<TvcProduct>;
    ViewData["Title"] = product?.Name ?? "Chi tiết sản phẩm";
}

<div class="container my-4">
    @if (product != null)
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <a asp-controller="TvcProduct" asp-action="Index" class="btn btn-outline-danger">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="border rounded p-3 text-center bg-white shadow-sm">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.Name" class="w-100 rounded" style="max-height: 400px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="w-100 rounded" style="height: 350px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-7">
                <div class="card p-4 shadow-sm border-0">
                    <h2 class="fw-bold text-primary mb-3">@product.Name</h2>
                    <p class="text-muted"><strong>Mô tả:</strong> @product.Description</p>
                    <hr />

                    <div class="mb-3">
                        <p class="mb-1">
                            <strong>Giá gốc:</strong>
                            <span class="text-decoration-line-through text-muted ms-2">@product.Price.ToString("N0") VNĐ</span>
                        </p>
                        <p class="mb-1">
                            <strong>Giá khuyến mãi:</strong>
                            <span class="text-danger fw-bold fs-4 ms-2">@product.SalePrice.ToString("N0") VNĐ</span>
                        </p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 mb-2"><strong>Danh mục:</strong> @product.Category</div>
                        <div class="col-6 mb-2"><strong>Năm phát hành:</strong> @product.ReleaseYear</div>
                        <div class="col-6 mb-2"><strong>Nền tảng:</strong> @product.Platform</div>
                        <div class="col-6 mb-2"><strong>Nhà phát hành:</strong> @product.Publisher</div>
                        <div class="col-6 mb-2"><strong>Nhà phát triển:</strong> @product.Developer</div>
                    </div>

                    <p class="mb-3">
                        <strong>Đánh giá:</strong>
                        @if (product.Rating > 0)
                        {
                            double ratingOn5 = product.Rating / 2.0;
                            for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(ratingOn5))
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                                else if (i - ratingOn5 > 0 && i - ratingOn5 <= 0.5)
                                {
                                    <i class="fas fa-star-half-alt text-warning"></i>
                                }
                                else
                                {
                                    <i class="far fa-star text-warning"></i>
                                }
                            }
                            <span class="ms-1 text-muted">(@product.Rating / 10)</span>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có đánh giá</span>
                        }
                    </p>

                    <p class="mb-4">
                        <strong>Trạng thái:</strong>
                        @if (product.IsHot)
                        {
                            <span class="badge bg-warning text-dark me-1">HOT</span>
                        }
                        @if (product.IsNew)
                        {
                            <span class="badge bg-success me-1">MỚI</span>
                        }
                        <span class="badge bg-info text-dark">Đã phát hành</span>
                    </p>

                    <div class="d-flex gap-2">
                        <a asp-controller="TvcProduct" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Danh sách
                        </a>
                        <button class="btn btn-success px-4">
                            <i class="fas fa-shopping-cart"></i> Mua ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (relatedProducts != null && relatedProducts.Any())
        {
            <div class="row mt-5">
                <div class="col-12">
                    <h4 class="fw-bold">Sản phẩm liên quan</h4>
                    <hr />
                </div>
                @foreach (var item in relatedProducts)
                {
                    <div class="col-md-3 mb-3 d-flex align-items-stretch">
                        <div class="card w-100 shadow-sm">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="w-100 rounded" style="height: 150px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="w-100 rounded" style="height: 150px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                            <span class="text-muted">No Image</span>
                                        </div>
                                    }
                                    <h6 class="mt-2 fw-bold">@item.Name</h6>
                                    <p class="text-danger fw-bold">@item.SalePrice.ToString("N0") VNĐ</p>
                                </div>
                                <a asp-controller="TvcProduct" asp-action="TvcSanPham" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-100">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger text-center my-5 py-4">
            <h4 class="fw-bold">Không tìm thấy sản phẩm!</h4>
            <p class="text-muted">Sản phẩm bạn đang tìm không tồn tại hoặc đã bị xóa.</p>
            <a asp-controller="TvcProduct" asp-action="Index" class="btn btn-danger mt-2">Quay lại danh sách</a>
        </div>
    }
</div>