@{
    ViewData["Title"] = "Trang chủ";
}

<div class="bg-primary text-white p-2 mb-3">Sản phẩm mới nhất</div>
<div class="row">
    @if (ViewBag.NewProducts != null)
    {
        foreach (var item in ViewBag.NewProducts as List<TvcLesson06Lab.Models.Product>)
        {
            <div class="col-md-4 mb-3 new-product-col">
                <div class="card h-100 new-product-card">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title text-center">@item.ProductName</h6>
                        <p class="text-danger text-center fw-bold">@item.Price.ToString("N0") đ</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="bg-primary text-white p-2 mb-3 mt-4">Sản phẩm Hot</div>
@await Component.InvokeAsync("HotProduct")